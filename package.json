{
  "name": "glint",
  "private": true,
  "version": "0.1.5",
  "description": "A fast desktop video player with a YouTube-style interface",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.18.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "author": "Adham Yasser",
  "license": "MIT"
}
